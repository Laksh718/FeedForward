.venv/
.venv_mac/
.env
# Generated by the pipeline. Only what the server needs at run time is kept in git (about 6 MB), so a container
# host can run the app straight from the repository: the final model, the processed tables and the time series.
artifacts/*
!artifacts/models/
artifacts/models/*
!artifacts/models/final/
!artifacts/processed/
!artifacts/timeseries/
data_store/admin_logs/*
!data_store/admin_logs/.gitkeep
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Static site build output (published to the gh-pages branch by scripts/deploy_pages.sh)
site/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
