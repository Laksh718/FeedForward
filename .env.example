# Copy this file to .env and fill it in. Never commit .env.

# Language model for the copilot: Groq (key from https://console.groq.com). One request per answer.
# Without any key the copilot still works with template answers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional fallback, used only when GROQ_API_KEY is empty: Google Gemini (key from https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# PIN for the Daily log (admin) tab
ADMIN_PIN=1234

# Optional: allow another web address to call the API (comma separated). Closed when empty.
CORS_ORIGINS=
# Optional: pretend today is another date (YYYY-MM-DD). The project's today is 2026-10-06.
FEEDFORWARD_TODAY=
