# Copy this file to .env and fill it in. Never commit .env.

# Language model for the copilot (Groq). Without a key the copilot still works with template answers.
GROQ_API_KEY=
# Check this model name is still available in your Groq console before the demo.
GROQ_MODEL=llama-3.3-70b-versatile

# PIN for the Daily log (admin) tab
ADMIN_PIN=change-me

# Optional: allow another web address to call the API (comma separated). Closed when empty.
CORS_ORIGINS=
# Optional: pretend today is another date (YYYY-MM-DD). The project's today is 2026-10-06.
FEEDFORWARD_TODAY=
