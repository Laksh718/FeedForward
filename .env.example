# Copy this file to .env and fill it in. Never commit .env.

# Language model for the copilot: Google Gemini (key from https://aistudio.google.com/apikey). One request per answer.
# Without a key the copilot still works with template answers.
GEMINI_API_KEY=
# Check this model name is still available in Google AI Studio before the demo.
GEMINI_MODEL=gemini-3.1-flash-lite

# PIN for the Daily log (admin) tab
ADMIN_PIN=1234

# Optional: allow another web address to call the API (comma separated). Closed when empty.
CORS_ORIGINS=
# Optional: pretend today is another date (YYYY-MM-DD). The project's today is 2026-10-06.
FEEDFORWARD_TODAY=
